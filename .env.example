# ── App ──────────────────────────────────────────────────────────────────────
SECRET_KEY=                              # run: openssl rand -hex 32
ENVIRONMENT=development                  # development | production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=releasewatch
POSTGRES_USER=rw_user
POSTGRES_PASSWORD=                       # set a strong password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=3600

# ── S3 / MinIO ────────────────────────────────────────────────────────────────
# For AWS S3: leave S3_ENDPOINT_URL empty and set S3_REGION
# For MinIO:  set S3_ENDPOINT_URL to your MinIO server URL
S3_ENDPOINT_URL=                         # e.g. https://minio.example.com
S3_BUCKET_NAME=releasewatch
S3_ACCESS_KEY=                           # your access key
S3_SECRET_KEY=                           # your secret key
S3_REGION=us-east-1
S3_PRESIGN_EXPIRY=3600
S3_USE_PRESIGNED=true
S3_PUBLIC_URL_BASE=
S3_LARGE_FILE_THRESHOLD_MB=100
S3_LARGE_FILE_RETENTION_DAYS=60

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=                      # from @BotFather
TELEGRAM_BOT_USERNAME=                   # e.g. MyBot
FRONTEND_URL=http://localhost:8080       # used in Telegram deep links

# ── Admin bootstrap ───────────────────────────────────────────────────────────
ADMIN_PASSWORD=                          # set by deploy.sh on first deploy; change after first login

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30

# ── Federated auth (OPTIONAL) ───────────────────────────────────────────────────
# External providers are opt-in. Leave a provider's vars blank to disable it;
# with all blank, Releasewatch uses local username/password only (unchanged).
FEDERATED_DEFAULT_ROLE=developer         # role for JIT-provisioned users (Phase 1)

# Keycloak (OIDC) — enabled only when ISSUER + CLIENT_ID + CLIENT_SECRET + REDIRECT_URI are all set
KEYCLOAK_ISSUER=                         # e.g. https://kc.example.com/realms/rw
KEYCLOAK_CLIENT_ID=                      # confidential client id
KEYCLOAK_CLIENT_SECRET=                  # confidential client secret (SECRET)
KEYCLOAK_REDIRECT_URI=                   # e.g. https://rw.example.com/api/v1/auth/keycloak/callback
KEYCLOAK_SCOPES=openid profile email

# LDAP / Active Directory — enabled when SERVER_URI + (BIND_DN_TEMPLATE or SERVICE creds+BASE_DN) set
LDAP_SERVER_URI=                         # e.g. ldaps://ad.corp.local:636
LDAP_BIND_DN_TEMPLATE=                   # direct UPN bind, e.g. {username}@corp.local (no service acct needed)
LDAP_USE_TLS=true
LDAP_ATTR_NAME=displayName
LDAP_ATTR_EMAIL=mail
# Only for search-then-bind (leave blank when using direct UPN bind above):
LDAP_USER_BASE_DN=                       # e.g. OU=Users,DC=corp,DC=local
LDAP_USER_FILTER=(userPrincipalName={username})
LDAP_SERVICE_BIND_DN=                    # service account DN
LDAP_SERVICE_PASSWORD=                   # service account password (SECRET)
